# ==============================================================================
# XLIBERTINE — TEMPLATE DAS VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Copia este ficheiro para .env.local (dev) e para as "Variables d'environnement"
# do deployment no Hostinger (produção). Os valores REAIS desta máquina estão
# em .env.production (não commitado — este repo é público, não colar segredos
# aqui). Dump rápido para copiar/colar:
#     ! cat /root/libertin/.env.production
# ==============================================================================

# --- Supabase (públicos: vão a todos os navegadores, sem segredo) -------------
NEXT_PUBLIC_SUPABASE_URL=https://mfchfnsekoluicxnguoh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_APP_URL=https://xlibertine.com

# --- Segredos do servidor (nunca commitar — repo público) ---------------------

# Chave legacy service_role do Supabase (formato JWT `eyJ...` com 3 segmentos,
# 200+ caracteres). NÃO usar o formato novo `sb_secret_...`: a REST/PostgREST
# aceita-o, mas o Storage não — os uploads de foto falham com
# « Invalid Compact JWS ». No Supabase: Project Settings → API Keys → Legacy
# API keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Chave secreta da Stripe (live, `rk_live_...` RESTRICTED — permissões mínimas:
# Products write, Customers incl. DELETE; Prices/Links/Checkout precisam de
# read+write marcado no editor da chave).
STRIPE_SECRET_KEY=

# Secret do webhook da Stripe (assina e valida cada evento; sem ele o webhook
# não ativa/renova/revoga Premium em `profiles`).
STRIPE_WEBHOOK_SECRET=

# Payment Links recorrentes mensais (9/15/25€) — criar novo link para mudar
# de preço (o valor de um link existente não se edita).
STRIPE_LINK_PASS_EPICURIEN=
STRIPE_LINK_PASS_PRIVILEGE=
STRIPE_LINK_PASS_VIP=

# --- Opcionais ----------------------------------------------------------------

# Bucket de fotos de perfil (default: photos)
# SUPABASE_PHOTOS_BUCKET=photos

# Deteção NSFW (Google Vision) — sem estas variáveis os uploads passam sem scan.
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_VISION_API_KEY=