# ============================================
# SUPABASE — Database & Auth
# ============================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_YOUR_SERVICE_ROLE_KEY"
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# ============================================
# STRIPE — Payments & Subscriptions
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_YOUR_KEY"
STRIPE_SECRET_KEY="sk_live_YOUR_KEY"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_KEY"

# Stripe Product IDs (create in Stripe Dashboard)
STRIPE_PRODUCT_PREMIUM_3M="prod_YOUR_3M"
STRIPE_PRODUCT_PREMIUM_12M="prod_YOUR_12M"
STRIPE_PRODUCT_PREMIUM_24M="prod_YOUR_24M"

# ============================================
# EMAIL — Notifications & Transactional
# ============================================
# Option 1: Resend (recommended for startups)
RESEND_API_KEY="re_YOUR_KEY"
RESEND_FROM_EMAIL="noreply@xlibertine.com"

# Option 2: SendGrid (alternative)
SENDGRID_API_KEY="SG.YOUR_KEY"

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL="https://xlibertine.com"
NODE_ENV="production"

# ============================================
# CONTENT MODERATION (Optional)
# ============================================
# Google Cloud Vision (NSFW detection)
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# Cloudinary (image hosting & moderation)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_API_KEY"
CLOUDINARY_API_SECRET="YOUR_API_SECRET"

# ============================================
# ANALYTICS
# ============================================
NEXT_PUBLIC_POSTHOG_KEY="phc_YOUR_KEY"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ============================================
# AI (Optional Gemini)
# ============================================
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
